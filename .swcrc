{
  "jsc": {
    "parser": {
      "syntax": "typescript",
      "tsx": false,
      "decorators": false
    },
    "target": "es2022",
    "transform": {
      "legacyDecorator": false,
      "decoratorMetadata": false
    }
  },
  "module": {
    "type": "commonjs",
    "strict": true,
    "lazy": false
  }
}
