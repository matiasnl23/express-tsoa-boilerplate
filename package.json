{
  "name": "open-store",
  "packageManager": "yarn@4.1.1",
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && swc src -d dist --strip-leading-paths",
    "build:watch": "yarn build --watch",
    "start": "node dist/index.js",
    "dev": "node -r @swc-node/register src/index.ts",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/index.ts",
    "type-check": "tsc --noEmit"
  },
  "volta": {
    "node": "20.19.0",
    "yarn": "4.9.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.10",
    "@swc/cli": "^0.7.3",
    "@swc/core": "^1.11.21",
    "@types/convict": "^6.1.6",
    "@types/node": "^22.14.1",
    "chokidar": "^4.0.3",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "convict": "^6.2.4",
    "dotenv": "^16.5.0",
    "pino": "^9.6.0"
  }
}
