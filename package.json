{
  "name": "open-store",
  "packageManager": "yarn@4.1.1",
  "scripts": {
    "clean": "rimraf dist",
    "build": "yarn clean && yarn tsoa spec-and-routes && swc src -d dist --strip-leading-paths",
    "build:watch": "yarn build --watch",
    "start": "node dist/index.js",
    "dev:watch": "ts-node-dev --respawn --transpile-only src/index.ts",
    "type-check": "tsc --noEmit",
    "tsoa:watch": "chokidar \"src/controllers/**/*.ts\" -c \"yarn tsoa spec-and-routes\"",
    "dev": "concurrently -k \"yarn dev:watch\" \"yarn tsoa:watch\"",
    "migration": "ts-node src/migrations"
  },
  "volta": {
    "node": "20.19.0",
    "yarn": "4.9.1"
  },
  "devDependencies": {
    "@swc-node/register": "^1.10.10",
    "@swc/cli": "^0.7.3",
    "@swc/core": "^1.11.21",
    "@types/convict": "^6.1.6",
    "@types/express": "^5.0.1",
    "@types/node": "^22.14.1",
    "@types/pg": "^8.11.13",
    "@types/swagger-jsdoc": "^6",
    "@types/swagger-ui-express": "^4.1.8",
    "chokidar": "^4.0.3",
    "chokidar-cli": "^3.0.0",
    "concurrently": "^9.1.2",
    "pino-pretty": "^13.0.0",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "convict": "^6.2.4",
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "pg": "^8.14.1",
    "pg-hstore": "^2.3.4",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "sequelize": "^6.37.7",
    "sequelize-typescript": "^2.1.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^6.6.0",
    "umzug": "^3.8.2"
  }
}
